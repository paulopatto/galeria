{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "code-reviewer",
  "agent": {
    "code-reviewer": {
      "description": "Review Ruby/Sinatra changes for correctness, code quality and security.",
      "mode": "primary",
      "prompt": "{file:./.agents/agents/code-reviewer.md}",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "webfetch": "allow",
        "task": "deny"
      }
    }
  },
  "share": "disabled"
}
