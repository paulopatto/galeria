{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "code-reviewer",
  "agent": {
    "code-reviewer": {
      "description": "Review Ruby/Sinatra changes for correctness, code quality and security.",
      "mode": "primary",
      "prompt": "{file:./.agents/agents/code-reviewer.md}",
      "permission": {
        "*": "deny"
      },
      "steps": 1,
      "temperature": 0,
      "tools": {
        "*": false
      }
    }
  },
  "share": "disabled",
  "provider": {
    "opencode": {
      "options": {
        "timeout": 90000
      },
      "models": {
        "big-pickle": {
          "limit": {
            "context": 200000,
            "input": 160000,
            "output": 2000
          }
        }
      }
    }
  }
}
